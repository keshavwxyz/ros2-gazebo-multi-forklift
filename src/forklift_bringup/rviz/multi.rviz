Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_1/map
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/RobotModel
    Name: forklift_1 model
    Enabled: true
    Value: true
    Description Source: Topic
    Description Topic:
      Value: /forklift_1/robot_description
    TF Prefix: forklift_1
  - Class: rviz_default_plugins/LaserScan
    Name: forklift_1 front scan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_1/scan_filtered
      Reliability Policy: Best Effort
    Color: 0; 170; 255
    Size (m): 0.04
  - Class: rviz_default_plugins/LaserScan
    Name: forklift_1 rear scan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_1/scan_rear
      Reliability Policy: Best Effort
    Color: 255; 0; 0
    Size (m): 0.04
  - Class: rviz_default_plugins/Path
    Name: forklift_1 plan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_1/plan
    Color: 0; 170; 255
  - Class: rviz_default_plugins/Polygon
    Name: forklift_1 footprint
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_1/local_costmap/published_footprint
    Color: 0; 170; 255
  - Class: rviz_default_plugins/RobotModel
    Name: forklift_2 model
    Enabled: true
    Value: true
    Description Source: Topic
    Description Topic:
      Value: /forklift_2/robot_description
    TF Prefix: forklift_2
  - Class: rviz_default_plugins/LaserScan
    Name: forklift_2 front scan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_2/scan_filtered
      Reliability Policy: Best Effort
    Color: 255; 120; 0
    Size (m): 0.04
  - Class: rviz_default_plugins/LaserScan
    Name: forklift_2 rear scan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_2/scan_rear
      Reliability Policy: Best Effort
    Color: 255; 0; 0
    Size (m): 0.04
  - Class: rviz_default_plugins/Path
    Name: forklift_2 plan
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_2/plan
    Color: 255; 120; 0
  - Class: rviz_default_plugins/Polygon
    Name: forklift_2 footprint
    Enabled: true
    Value: true
    Topic:
      Value: /forklift_2/local_costmap/published_footprint
    Color: 255; 120; 0
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 40
      X: 0
      Y: 0
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 800
