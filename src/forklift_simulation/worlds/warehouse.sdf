<?xml version="1.0"?>
<!--
  Compact warehouse for the forklift mission (Gazebo Sim Harmonic, SDF 1.10).

  World frame: the origin is at the center of the hall, x is east, y is north.
  Interior: x from -8 to 8, y from -6 to 6.

  Layout (all items are static and deterministic):
    HOME          (-6.0,  0.0)  green floor marking, spawn pose of the robot (yaw 0, pointed to +x)
    PICK_01..03   (-3/0/3, -4.6) yellow floor markings; Phase 4 adds the boxes on pallets
    SHELF_01..03  (-3/0/3,  5.3) blue storage platforms, 1.2 x 1.0 m, deck at 0.25 m
    East rack     x = 7.2, y from -3 to 3   solid base + shelves (LiDAR/map feature)
    Columns       (-1.5, 0.0), (1.5, 0.0) 0.3 x 0.3 m structural columns
    Crate stack   (6.0, -4.6)             static obstacle

  Lighting: a directional sun plus ten ceiling point lights above the aisles.

  All items that a 2D LiDAR at 0.12 m must see are solid down to the floor (platform
  fronts, rack base, columns). Thus, the maps from the scans contain them.
-->
<sdf version="1.10">
  <world name="warehouse">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Ceiling lights above the two aisles (y = -2 and y = +2). Without these lights, vertical
         faces that point to an aisle (for example, the QR labels of the loads at the pickups and
         on the platforms) would get only ambient light from the direction of the sun.-->
    <light type="point" name="aisle_light_s_0">
      <pose>-6.0 -2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_s_3">
      <pose>-3.0 -2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_s_6">
      <pose>0.0 -2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_s_9">
      <pose>3.0 -2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_s_12">
      <pose>6.0 -2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_n_0">
      <pose>-6.0 2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_n_3">
      <pose>-3.0 2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_n_6">
      <pose>0.0 2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_n_9">
      <pose>3.0 2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="aisle_light_n_12">
      <pose>6.0 2.0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>9</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- ============================== Floor ============================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse></material>
        </visual>
        <!-- Floor markings: visual only (no collision). Perception does not use them.-->
        <visual name="home_marking">
          <pose>-6.0 0 0.001 0 0 0</pose>
          <geometry><box><size>2.8 1.4 0.001</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
        </visual>
        <visual name="pick_01_marking">
          <pose>-3.0 -4.6 0.001 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.001</size></box></geometry>
          <material><ambient>0.7 0.6 0.0 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="pick_02_marking">
          <pose>0.0 -4.6 0.001 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.001</size></box></geometry>
          <material><ambient>0.7 0.6 0.0 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="pick_03_marking">
          <pose>3.0 -4.6 0.001 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.001</size></box></geometry>
          <material><ambient>0.7 0.6 0.0 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================== Walls ============================== -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>0 6.1 1.25 0 0 0</pose><geometry><box><size>16.4 0.2 2.5</size></box></geometry></collision>
        <visual name="north_v"><pose>0 6.1 1.25 0 0 0</pose><geometry><box><size>16.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="south"><pose>0 -6.1 1.25 0 0 0</pose><geometry><box><size>16.4 0.2 2.5</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -6.1 1.25 0 0 0</pose><geometry><box><size>16.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="east"><pose>8.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 12.0 2.5</size></box></geometry></collision>
        <visual name="east_v"><pose>8.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 12.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
        <collision name="west"><pose>-8.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 12.0 2.5</size></box></geometry></collision>
        <visual name="west_v"><pose>-8.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 12.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== Storage platforms (destinations) ===================== -->
    <model name="storage_platforms">
      <static>true</static>
      <link name="link">
        <collision name="shelf_01"><pose>-3.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry></collision>
        <visual name="shelf_01_v"><pose>-3.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry>
          <material><ambient>0.1 0.25 0.6 1</ambient><diffuse>0.15 0.3 0.75 1</diffuse></material></visual>
        <collision name="shelf_02"><pose>0.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry></collision>
        <visual name="shelf_02_v"><pose>0.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry>
          <material><ambient>0.1 0.25 0.6 1</ambient><diffuse>0.15 0.3 0.75 1</diffuse></material></visual>
        <collision name="shelf_03"><pose>3.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry></collision>
        <visual name="shelf_03_v"><pose>3.0 5.3 0.125 0 0 0</pose><geometry><box><size>1.2 1.0 0.25</size></box></geometry>
          <material><ambient>0.1 0.25 0.6 1</ambient><diffuse>0.15 0.3 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== East rack (static structure) ===================== -->
    <model name="east_rack">
      <static>true</static>
      <pose>7.2 0 0 0 0 0</pose>
      <link name="link">
        <collision name="base"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.8 6.0 0.3</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.8 6.0 0.3</size></box></geometry>
          <material><ambient>0.5 0.2 0.05 1</ambient><diffuse>0.65 0.3 0.1 1</diffuse></material></visual>
        <collision name="shelf_1"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>0.8 6.0 0.05</size></box></geometry></collision>
        <visual name="shelf_1_v"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>0.8 6.0 0.05</size></box></geometry>
          <material><ambient>0.5 0.2 0.05 1</ambient><diffuse>0.65 0.3 0.1 1</diffuse></material></visual>
        <collision name="shelf_2"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>0.8 6.0 0.05</size></box></geometry></collision>
        <visual name="shelf_2_v"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>0.8 6.0 0.05</size></box></geometry>
          <material><ambient>0.5 0.2 0.05 1</ambient><diffuse>0.65 0.3 0.1 1</diffuse></material></visual>
        <collision name="upright_s"><pose>0 -3.0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry></collision>
        <visual name="upright_s_v"><pose>0 -3.0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.5 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material></visual>
        <collision name="upright_m"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry></collision>
        <visual name="upright_m_v"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.5 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material></visual>
        <collision name="upright_n"><pose>0 3.0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry></collision>
        <visual name="upright_n_v"><pose>0 3.0 1.0 0 0 0</pose><geometry><box><size>0.8 0.08 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.5 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================== Columns ============================== -->
    <model name="columns">
      <static>true</static>
      <link name="link">
        <collision name="column_w"><pose>-1.5 0 1.25 0 0 0</pose><geometry><box><size>0.3 0.3 2.5</size></box></geometry></collision>
        <visual name="column_w_v"><pose>-1.5 0 1.25 0 0 0</pose><geometry><box><size>0.3 0.3 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.75 0.75 0.15 1</diffuse></material></visual>
        <collision name="column_e"><pose>1.5 0 1.25 0 0 0</pose><geometry><box><size>0.3 0.3 2.5</size></box></geometry></collision>
        <visual name="column_e_v"><pose>1.5 0 1.25 0 0 0</pose><geometry><box><size>0.3 0.3 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.75 0.75 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================== Static obstacle ============================== -->
    <model name="crate_stack">
      <static>true</static>
      <pose>6.0 -4.6 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
