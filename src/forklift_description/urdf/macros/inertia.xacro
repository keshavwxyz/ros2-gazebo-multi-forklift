<?xml version="1.0"?>
<!-- Inertia macros for solid primitives. Each macro takes the origin of the inertial frame as a block.-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
               izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder with its axis along the y axis of the link (wheels).-->
  <xacro:macro name="cylinder_y_inertial" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
               iyy="${m * r * r / 2.0}" iyz="0"
               izz="${m * (3*r*r + h*h) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder with its axis along the z axis of the link.-->
  <xacro:macro name="cylinder_z_inertial" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12.0}" iyz="0"
               izz="${m * r * r / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${0.4 * m * r * r}" ixy="0" ixz="0"
               iyy="${0.4 * m * r * r}" iyz="0"
               izz="${0.4 * m * r * r}"/>
    </inertial>
  </xacro:macro>

</robot>
